{
  "expo": {
    "name": "smart-transyt",
    "slug": "smart-transyt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/App-icon.png",
    "scheme": "smarttransyt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/App-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/App-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/App-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splashscreen-image/splashscreen.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
